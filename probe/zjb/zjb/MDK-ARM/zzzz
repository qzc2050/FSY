; *************************************************************
; *** OTA App 分散加载文件
; *** App 区: 0x08002000 - 0x0800FFFF (56KB)
; *** 注意: Bootloader 占用 0x08000000-0x08001FFF (8KB)
; *************************************************************

LR_IROM1 0x08002000 0x0000E000  {    ; App load region (56KB)
  ER_IROM1 0x08002000 0x0000E000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00005000  {  ; RW data (20KB RAM)
   .ANY (+RW +ZI)
  }
}

